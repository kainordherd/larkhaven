{
  "unstable": ["kv", "broadcast-channel"],
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read --allow-write main.ts",
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-write main.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write",
    "preview": "deno run --allow-net --allow-env --allow-read preview.ts",
    "check": "deno check main.ts src/*.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/http": "jsr:@std/http@^1",
    "@std/ulid": "jsr:@std/ulid@^1",
    "jose": "npm:jose@^5"
  },
  "fmt": { "lineWidth": 100 }
}
