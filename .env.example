# Public URL of this service (used for OIDC redirect URI and cookie security).
# Register  <BASE_URL>/auth/callback  as the redirect URI at your OIDC provider.
BASE_URL=http://localhost:8000
PORT=8000

OIDC_ISSUER=https://accounts.example.com
OIDC_CLIENT_ID=meowhook
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile

# true: any user who authenticates is registered automatically.
# false: only existing users and emails in ALLOWED_EMAILS may sign in.
ALLOW_SELF_REGISTER=true
ALLOWED_EMAILS=

KV_PATH=./data/meowhook.db
SESSION_TTL_HOURS=168
MAX_BODY_BYTES=524288
EVENT_RETENTION_DAYS=7
LOG_RETENTION_DAYS=7
# Set true when behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
